# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Spotify app credentials (https://developer.spotify.com/dashboard)
# Add redirect URI: http://127.0.0.1:3000/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Your Spotify user id (the id in your profile URL). Only this account may sign in; unset,
# the stored me_id stands in, and an empty store lets the first login through.
SPOTIFY_OWNER_ID=
# The owner's lazyboy user id (docs/multi-user/PLAN.md §4.4, §11.4): 12 characters of
# a-z and 2-7, generated once and kept (not a secret). Every session cookie names it; with
# it unset or malformed, every sign-in is refused. Generate one with:
#   node -e "const b='abcdefghijklmnopqrstuvwxyz234567';console.log([...require('crypto').randomBytes(12)].map(x=>b[x&31]).join(''))"
# Pointing dev at Rem's database? Use production's value: the database names its owner
# (meta.owner_uid) and refuses anyone else. Every store script takes --user <this value>.
OWNER_UID=

# Base URL Auth.js uses to build callback URLs. Pin it locally to 127.0.0.1 so the
# redirect_uri matches your registered URI (Spotify rejects "localhost").
AUTH_URL=http://127.0.0.1:3000
# In production set it to your deployed origin, e.g. https://your-domain.com

# Turso (libSQL) — Rem's database, `lazyboy`: listen history and library (src/lib/db.ts, the
# database OWNER_UID's users row names). Leave BOTH blank locally to fall back to a SQLite file at
# data/listens.db; set them in prod (and locally if you want dev to use Turso too).
# Use the https:// form of the URL (libsql:// means websockets, which skip the store
# fetch). Get them from: turso db show <name> --url  and: turso db tokens create <name>
# Production's TURSO_AUTH_TOKEN is the group token (turso group tokens create default), which
# also reaches the app database below.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# The app database, `lazyboy-app` (multi-user Phase 2, src/lib/app-db.ts): the users, their
# encrypted Spotify tokens, scheduling and isolation events. Leave blank locally: dev uses its
# own file, data/app.db, beside the dev store (README's local start makes your row in it). Only
# production may point at a remote one (the https:// URL); any other environment refuses it.
APP_DATABASE_URL=
# The keys that encrypt Spotify tokens at rest (PLAN §5.3): `v<n>:<base64 of 32 bytes>`,
# comma-separated, the first one writing. Dev has its own, never production's. Generate one:
#   echo "v1:$(openssl rand -base64 32)"
# Missing or wrong, every request answers "unavailable" and nothing is written; a lost key
# means signing in again.
TOKEN_KEYS=
# Who may sign in: unset or `owner` = only OWNER_UID's row; `invite` = the users rows Rem adds
# (Phase 4a). Set back to `owner` and redeploy to freeze every friend at once (PLAN §12.1).
SIGNUPS=
# 1 only to roll back below Phase 2 after its first week (docs/SECURITY.md, Rollbacks): the
# runtime then writes the owner's plaintext token row back from his encrypted one.
LB_TOKEN_ROLLBACK=
# Every other user's database URL, `{db}` standing for its db_name (multi-user Phase 2:
# https://{db}-<org>.<region>.turso.io). Unset in Phase 1, where Rem is the only user.
STORE_URL_TEMPLATE=
# The database name the usage check reconciles (Production only; defaults to lazy-boy).
TURSO_DATABASE_NAME=

# The telemetry store: api_log, client_metrics, usage_ledger (db.ts getTelemetryClient()).
# Production: the Zenbook's sqld through the Funnel, with its JWT. Leave blank (or equal to
# TURSO_DATABASE_URL) and the log tables sit in Rem's database, as in dev and tests.
TELEMETRY_DATABASE_URL=
TELEMETRY_AUTH_TOKEN=

# Shared secret for every /api/cron/* route (src/lib/cron-auth.ts). Generate with
# openssl rand -base64 32. Vercel's crons send it as `Authorization: Bearer <secret>`.
CRON_SECRET=
# The cron-job.org pinger's own secret (Production only; leave blank locally): opens
# /api/cron/sync and nothing else, and its caller gets a bare {"ok":true}. Unset, it matches nobody.
CRON_SECRET_EXT=
